# Copy to .env for local overrides. Every value here is optional.

# SQLite by default. Use PostgreSQL for anything that must keep its data:
# DATABASE_URL=postgresql://user:password@host:5432/courtmate
DATABASE_URL=sqlite:///./courtmate.db

# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://your-courtmate-app.vercel.app

# development | production (production adds Strict-Transport-Security)
ENVIRONMENT=development

# Demo venues, players and bookings, all labelled as demo. Turn off for a real launch.
SEED_DEMO_DATA=true
# Password-less sign-in as the demo player or demo venue operator. Follows SEED_DEMO_DATA unless set.
DEMO_LOGIN=true
# The demo administrator can edit the sport catalog and verify venues.
# On by default in development, off by default when ENVIRONMENT=production.
# DEMO_ADMIN_LOGIN=false

# Apply database migrations on startup.
AUTO_MIGRATE=true
RATE_LIMIT_ENABLED=true
TOKEN_TTL_HOURS=336
# Largest request body accepted, in bytes.
MAX_BODY_BYTES=262144
# Behind a reverse proxy, let the server read the real client address from forwarded headers.
# FORWARDED_ALLOW_IPS=*
